{
  "name": "airin-play-solver",
  "private": true,
  "version": "2026.1.1",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @airin-play/v2 dev",
    "dev:v2": "pnpm --filter @airin-play/v2 dev",
    "build:v2": "pnpm --filter @airin-play/v2 build",
    "build": "pnpm build:v2 && tsx scripts/assemble-dist.ts",
    "version:set": "tsx scripts/bump-version.ts",
    "release:set": "tsx scripts/set-release.ts",
    "release:prepare": "tsx scripts/prepare-release.ts",
    "rc:create": "tsx scripts/rc/create.ts",
    "rc:add": "tsx scripts/rc/add-pr.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck": "pnpm typecheck:scripts && pnpm --filter @airin-play/v2 typecheck",
    "test:unit": "vitest run tests/core --pool=threads --maxWorkers=1",
    "test:e2e": "playwright test",
    "test:e2e:build": "pnpm build && pnpm test:e2e",
    "test": "pnpm check && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "@airin-play/core": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@playwright/test": "^1.62.1",
    "@types/node": "catalog:",
    "tsx": "4.23.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
